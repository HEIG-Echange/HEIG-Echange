meta {
  name: Change Password
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/auth/me
  body: json
  auth: none
}

body:json {
  {
    "currentPassword": "{{currentPassword}}",
    "password": "{{newPassword}}"
  }
}

vars:pre-request {
  currentPassword: password
  newPassword: nouveaumotdepasse123
}
