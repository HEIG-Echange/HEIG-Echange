meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "displayName": "{{name}}",
    "password": "{{password}}"
  }
}

vars:pre-request {
  password: password
  email: user@heig-vd.ch
  name: user
}
