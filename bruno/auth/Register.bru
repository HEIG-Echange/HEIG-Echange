meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "displayName": "{{name}}",
    "password": "{{password}}"
  }
}

vars:pre-request {
  password: password
  email: sofia.henriquesgarfo@heig-vd.ch
  name: user
}

script:post-response {
  // Present seulement si EXPOSE_VERIFICATION_CODE_FOR_TESTING=true (.env) —
  // permet d'enchainer directement sur "Verify Email" sans vraie boite mail.
  if (res.body && res.body.devVerificationCode) {
    bru.setVar("devVerificationCode", res.body.devVerificationCode);
  }
}
