meta {
  name: Update Listing
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/listings/{{listingId}}
  body: json
  auth: none
}

body:json {
  {
    "title": "{{title}}",
    "description": "{{description}}",
    "isPriority": {{isPriority}},
    "priorityGroupIds": [{{priorityGroupId}}],
    "priorityDurationHours": {{priorityDurationHours}}
  }
}

vars:pre-request {
  title: Calculatrice HP Prime G2 (modifiee)
  description: Description mise a jour
  isPriority: false
  priorityGroupId: 1
  priorityDurationHours: 48
}

script:pre-request {
  // Valeur par defaut si aucune annonce n'a ete creee dans cette session —
  // modifiable directement dans l'onglet Vars sinon.
  if (!bru.getVar("listingId")) {
    bru.setVar("listingId", 1);
  }
}
