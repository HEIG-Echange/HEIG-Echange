meta {
  name: Register Interest
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/listings/{{listingId}}/interest
  body: none
  auth: none
}

script:pre-request {
  // Valeur par defaut si aucune annonce n'a ete creee dans cette session —
  // modifiable directement dans l'onglet Vars sinon.
  if (!bru.getVar("listingId")) {
    bru.setVar("listingId", 1);
  }
}
