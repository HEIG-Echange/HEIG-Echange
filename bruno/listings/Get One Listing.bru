meta {
  name: Get One Listing
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/listings/{{listingId}}
  body: none
  auth: none
}

script:pre-request {
  // Valeur par defaut si aucune annonce n'a ete creee dans cette session
  // (ex. via "Create Listing", qui definit listingId automatiquement) —
  // modifiable directement dans l'onglet Vars sinon.
  if (!bru.getVar("listingId")) {
    bru.setVar("listingId", 1);
  }
}
