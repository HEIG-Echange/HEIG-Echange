meta {
  name: 03 Login Correct Password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{testEmail}}",
    "password": "{{testPassword}}"
  }
}

tests {
  test("renvoie 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("renvoie le bon compte", function () {
    expect(res.getBody().email).to.equal(bru.getVar("testEmail"));
  });
}
