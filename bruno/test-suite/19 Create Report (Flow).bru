meta {
  name: 19 Create Report (Flow)
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/reports
  body: json
  auth: none
}

body:json {
  {
    "listingId": {{flowListingId}},
    "reason": "Signalement de test (suite automatisee)"
  }
}

tests {
  test("renvoie 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("renvoie le signalement cree, statut open", function () {
    expect(res.getBody().listingId).to.equal(bru.getVar("flowListingId"));
    expect(res.getBody().status).to.equal("open");
  });
}

script:post-response {
  if (res.getBody() && res.getBody().id) {
    bru.setVar("flowReportId", res.getBody().id);
  }
}
