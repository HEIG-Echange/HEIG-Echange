meta {
  name: 12 Login With Old Password Rejected
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{testEmail}}",
    "password": "motdepasse123"
  }
}

tests {
  test("renvoie 401, l'ancien mot de passe ne fonctionne plus", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
