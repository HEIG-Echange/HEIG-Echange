meta {
  name: 10 Change Password Success
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/auth/me
  body: json
  auth: none
}

body:json {
  {
    "currentPassword": "{{testPassword}}",
    "password": "{{newTestPassword}}"
  }
}

script:pre-request {
  bru.setVar("newTestPassword", "nouveaumotdepasse123");
}

tests {
  test("renvoie 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("renvoie toujours le bon compte", function () {
    expect(res.getBody().email).to.equal(bru.getVar("testEmail"));
  });
}

script:post-response {
  // testPassword est utilise par les etapes suivantes (login avec le
  // nouveau mot de passe) : on le met a jour seulement si le changement a
  // reussi, pour ne pas casser la chaine sur un echec.
  if (res.getStatus() === 200) {
    bru.setVar("testPassword", bru.getVar("newTestPassword"));
  }
}
