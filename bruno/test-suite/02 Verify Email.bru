meta {
  name: 02 Verify Email
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/verify-email
  body: json
  auth: none
}

body:json {
  {
    "email": "{{testEmail}}",
    "code": "{{devVerificationCode}}"
  }
}

tests {
  test("renvoie emailVerified true", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().emailVerified).to.equal(true);
  });
}
