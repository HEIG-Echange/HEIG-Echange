post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{testEmail}}",
    "password": "{{testPassword}}"
  }
}

tests {
  test("renvoie 200 avec le nouveau mot de passe", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
