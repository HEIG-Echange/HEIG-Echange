meta {
  name: 17 Update Listing (Flow)
  type: http
  seq: 17
}

patch {
  url: {{baseUrl}}/listings/{{flowListingId}}
  body: json
  auth: none
}

body:json {
  {
    "title": "Objet test suite (modifie)",
    "description": "Description mise a jour par la suite automatisee."
  }
}

tests {
  test("renvoie 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("le titre est bien mis a jour", function () {
    expect(res.getBody().title).to.equal("Objet test suite (modifie)");
  });
}
