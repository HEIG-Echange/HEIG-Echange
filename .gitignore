# Dépendances
node_modules/

# Images uploadees en execution locale (UPLOAD_DIR par defaut). En Docker
# elles vivent dans le volume "uploads-data", jamais dans le depot.
uploads/

# Builds
dist/
build/
coverage/

# Environnement & secrets
.env
.env.*
!.env.example

# Clefs SSH — ne doivent jamais entrer dans le depot, meme temporairement
*_deploy_key
*_deploy_key_ci
*_deploy_key.pub
*.pem
id_ed25519*
id_rsa*
known_hosts.txt

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
