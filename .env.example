# Port d'ecoute de l'application (execution locale sans Docker)
PORT=3000

# Port expose sur la machine hote par Docker Compose.
# Le port interne au conteneur reste 3000 dans tous les cas.
APP_PORT=3000

# --- Plusieurs instances sur la meme machine (ex. 2 clones locaux) ---
#
# Docker Compose derive le nom de projet (et donc le nom des containers, du
# reseau et du volume db-data) du nom du DOSSIER courant si COMPOSE_PROJECT_NAME
# n'est pas defini. Deux clones de ce repo portant le MEME nom de dossier (ex.
# heig-echange/ clone deux fois) partagent alors le meme nom de projet : la
# 2e instance reutilise les containers/volume de la 1re au lieu d'en creer de
# nouveaux. Resultat concret : changer MARIADB_USER/PASSWORD/DATABASE dans le
# .env de la 2e instance n'a AUCUN effet, puisque MariaDB n'applique ces
# variables qu'a la toute premiere initialisation d'un volume vide -- la
# base "existante" (en fait celle de la 1re instance) est reprise telle
# quelle, avec ses anciens identifiants.
#
# => Pour faire tourner plusieurs instances en parallele sur une meme
#    machine, definir un COMPOSE_PROJECT_NAME UNIQUE par instance (en plus de
#    APP_PORT et PHPMYADMIN_PORT ci-dessous), meme si les dossiers ont des
#    noms differents -- c'est la garantie la plus sure.
# COMPOSE_PROJECT_NAME=heig-echange-instance1

# --- Base de donnees (MariaDB, service "db" dans compose.yaml) ---
MARIADB_DATABASE=heig_echange
MARIADB_USER=heig
MARIADB_PASSWORD=changeme
MARIADB_ROOT_PASSWORD=changeme-root

# Cote application : comment Express se connecte a MariaDB.
# En Docker, l'app rejoint la base via le nom de service "db" (reseau Compose
# interne) : DB_HOST=db et DB_PORT=3306 fonctionnent pour TOUTES les
# instances, meme en parallele, car ce port n'est jamais publie sur la
# machine hote (voir compose.yaml, service "db" : pas de section "ports").
# Ne pas modifier DB_PORT pour "eviter les conflits" entre instances : il n'y
# a pas de conflit possible sur ce port, et le changer casse la connexion
# (MariaDB continue d'ecouter sur 3306 a l'interieur du container).
# A ne changer que pour une execution locale sans Docker, contre une base
# externe.
DB_HOST=db
DB_PORT=3306

# Port expose sur la machine hote pour phpMyAdmin (profil "tools" uniquement) :
#   docker compose --profile tools up -d
PHPMYADMIN_PORT=8082

# Interface reseau sur laquelle phpMyAdmin est publie.
#   0.0.0.0    accessible depuis une autre machine du reseau (ex. pour
#              administrer la BDD a distance). C'est la valeur par defaut.
#   127.0.0.1  restreint l'acces a la machine locale uniquement (plus sur si
#              phpMyAdmin n'est pas censE etre joignable depuis l'exterieur).
# phpMyAdmin n'est pas servi en HTTPS ici : n'exposer 0.0.0.0 que sur un
# reseau de confiance (LAN prive, VPN), jamais directement sur Internet, et
# utiliser des mots de passe MARIADB_* forts des que ce port est ouvert.
PHPMYADMIN_BIND_ADDRESS=0.0.0.0

# --- Sessions (express-session) ---
# Signe le cookie de session : doit rester secret et etre unique par
# environnement (dev / staging / prod).
SESSION_SECRET=changeme-session-secret

# Cookie de session marque "Secure" (envoye uniquement en HTTPS). A mettre a
# "true" seulement une fois un vrai HTTPS en place devant l'app (reverse
# proxy TLS staging/prod) ; sinon express-session n'envoie plus aucun cookie.
COOKIE_SECURE=false
