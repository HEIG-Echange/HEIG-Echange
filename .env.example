# Port d'ecoute de l'application (execution locale sans Docker)
PORT=3000

# Port expose sur la machine hote par Docker Compose.
# Le port interne au conteneur reste 3000 dans tous les cas.
APP_PORT=3000

# --- Base de donnees (MariaDB, service "db" dans compose.yaml) ---
MARIADB_DATABASE=heig_echange
MARIADB_USER=heig
MARIADB_PASSWORD=changeme
MARIADB_ROOT_PASSWORD=changeme-root

# Cote application : comment Express se connecte a MariaDB.
# En Docker, l'app rejoint la base via le nom de service "db" (reseau Compose):
# DB_HOST=db et DB_PORT=3306 fonctionnent pour TOUTES les
# instances, meme en parallele, car ce port n'est jamais publie sur la
# machine hote (voir compose.yaml, service "db" : pas de section "ports").
# Ne pas modifier DB_PORT pour "eviter les conflits" entre instances.
# A ne changer que pour une execution locale sans Docker utilisant une BDD
# externe.
DB_HOST=db
DB_PORT=3306

# Interface reseau phpMyAdmin.
# 0.0.0.0 : administrer la BDD a distance.
# phpMyAdmin HTTP ici. ne pas exposer sur internet, sinon via reverse proxy.
PHPMYADMIN_BIND_ADDRESS=0.0.0.0

# Port expose sur la machine hote pour phpMyAdmin (profil "tools" uniquement) :
#   docker compose --profile tools up -d
PHPMYADMIN_PORT=8082

# --- Sessions (express-session) ---
# Signe le cookie de session : doit rester secret et etre unique par
# environnement (dev / staging / prod).
SESSION_SECRET=changeme-session-secret

# Cookie de session marque "Secure" (envoye uniquement en HTTPS). A mettre a
# "true" seulement une fois un vrai HTTPS en place devant l'app (reverse
# proxy TLS staging/prod) ; sinon express-session n'envoie plus aucun cookie.
COOKIE_SECURE=false

# --- URL publique de l application ---
# Domaine utilise pour TOUT lien destine a sortir de l'application :
#   - QR codes (profil utilisateur et fiche annonce)
#   - liens de partage d'annonce et liens absolus des images (/uploads/...)
#   - liens contenus dans les emails (confirmation, reconfirmation)
#   - liens d'invitation partages par email
# Laisse a localhost, ces liens sont inutilisables des qu'ils quittent la
# machine : A ADAPTER OBLIGATOIREMENT au domaine reel en staging/prod
# (ex. https://echange.heig-vd.ch). Sans slash final (il est retire de toute
# facon). L'app n'utilise jamais l'hote de la requete a la place.
PUBLIC_BASE_URL=http://localhost:3000

# --- Stockage des images uploadees ---
# En Docker, laisse a /app/uploads (monte sur le volume "uploads-data", defini
# dans compose.yaml). En execution locale sans Docker, un dossier ./uploads est
# cree automatiquement si cette variable n'est pas definie.
# UPLOAD_DIR=/app/uploads

# --- Analyse IA des photos (optionnel) ---
# HUGGINGFACE_API_KEY=hf_...
# AI_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# AI_SYSTEM_PROMPT=
# AI_USER_PROMPT=
#
# HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
# HUGGINGFACE_TIMEOUT_MS=60000

# --- Envoi d'email (verification a l'inscription) ---
# Service interne fourni par l'equipe reseau/infra. Ne JAMAIS committer la
# vraie clef API : uniquement dans .env (non versionne).
MAILER_BASE_URL=https://mailer.echange.online
MAILER_API_KEY=changeme-mailer-api-key
MAILER_FROM_EMAIL=no-reply@heig.echange.online

# Quand cette variable vaut exactement "true", /auth/register,
# /auth/resend-code et /auth/login (cas "a reconfirmer") renvoient AUSSI le
# code de verification dans la reponse JSON (champ devVerificationCode). Cela
# permet de tester sans acceder a une vraie boite mail : suite Bruno
# automatisee, et scripts/seed_demo_data.py qui en a besoin pour activer les
# comptes de demonstration.
#
# NE JAMAIS l'activer en staging expose ni en production : n'importe qui
# pourrait alors confirmer l'adresse d'un tiers.
#
# compose.dev.yaml la met deja a "true" :
#   docker compose -f compose.yaml -f compose.dev.yaml up --build

# EXPOSE_VERIFICATION_CODE_FOR_TESTING=false

# --- Reconfirmation d'adresse email ---
# Une confirmation d'adresse ne vaut que 6 mois (180 jours). Passe ce delai le
# compte est suspendu : connexion refusee et annonces masquees des listes
# publiques, jusqu'a reconfirmation. Le delai est une constante applicative
# (src/auth/emailVerification.ts), pas une variable d'environnement : le
# changer impacterait aussi les requetes SQL et la migration 004.
#
# Un balayage quotidien envoie les rappels (J-14) et les notifications de
# suspension. Il demarre avec le serveur (src/server.ts) ; il peut aussi etre
# declenche a la main par un admin :
#   POST /admin/jobs/email-reverification


# Cntinuous Delivery : backup DB de la DB mariadb dans ce dossier:
DB_BACKUP_PATH=/home/heigdeploy/heig/_backups

