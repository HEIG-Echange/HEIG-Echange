# Port d'ecoute de l'application (execution locale sans Docker)
PORT=3000

# Port expose sur la machine hote par Docker Compose.
# Le port interne au conteneur reste 3000 dans tous les cas.
APP_PORT=3000

# --- Base de donnees (MariaDB, service "db" dans compose.yaml) ---
MARIADB_DATABASE=heig_echange
MARIADB_USER=heig
MARIADB_PASSWORD=changeme
MARIADB_ROOT_PASSWORD=changeme-root

# Cote application : comment Express se connecte a MariaDB.
# En Docker, l'app rejoint la base via le nom de service "db" (reseau Compose):
# DB_HOST=db et DB_PORT=3306 fonctionnent pour TOUTES les
# instances, meme en parallele, car ce port n'est jamais publie sur la
# machine hote (voir compose.yaml, service "db" : pas de section "ports").
# Ne pas modifier DB_PORT pour "eviter les conflits" entre instances.
# A ne changer que pour une execution locale sans Docker utilisant une BDD
# externe.
DB_HOST=db
DB_PORT=3306

# Interface reseau phpMyAdmin.
# 0.0.0.0 : administrer la BDD a distance.
# phpMyAdmin HTTP ici. ne pas exposer sur internet, sinon via reverse proxy.
PHPMYADMIN_BIND_ADDRESS=0.0.0.0

# Port expose sur la machine hote pour phpMyAdmin (profil "tools" uniquement) :
#   docker compose --profile tools up -d
PHPMYADMIN_PORT=8082

# --- Sessions (express-session) ---
# Signe le cookie de session : doit rester secret et etre unique par
# environnement (dev / staging / prod).
SESSION_SECRET=changeme-session-secret

# Cookie de session marque "Secure" (envoye uniquement en HTTPS). A mettre a
# "true" seulement une fois un vrai HTTPS en place devant l'app (reverse
# proxy TLS staging/prod) ; sinon express-session n'envoie plus aucun cookie.
COOKIE_SECURE=false

# --- URL publique de l'application ---
# Domaine utilise pour les QR codes (profil utilisateur) et les liens
# d'invitation partages par email. A adapter au domaine reel en staging/prod
# (ex. https://echange.heig-vd.ch). Sans slash final.
PUBLIC_BASE_URL=http://localhost:3000

# --- Stockage des images uploadees ---
# En Docker, laisse a /app/uploads (monte sur le volume "uploads-data", defini
# dans compose.yaml). En execution locale sans Docker, un dossier ./uploads est
# cree automatiquement si cette variable n'est pas definie.
# UPLOAD_DIR=/app/uploads

# --- Analyse IA des photos (optionnel) ---
# Clef API Anthropic pour l'analyse des photos d'objets (categorie, etat,
# description pre-remplie). Si absente, l'app fonctionne normalement mais la
# pre-saisie automatique est desactivee.
# ANTHROPIC_API_KEY=sk-ant-...
# Modele utilise pour l'analyse (defaut : claude-opus-5).
# AI_MODEL=claude-opus-5
